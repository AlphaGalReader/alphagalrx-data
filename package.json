    "build": "tsx scripts/pipeline/3-build.ts",
    "check": "tsx scripts/pipeline/check.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
